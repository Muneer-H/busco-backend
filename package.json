{
  "name": "busco-backend",
  "version": "0.0.1",
  "description": "",
  "author": "IOMechs",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build:all": "nest build user-app && nest build admin-app && pnpm copy:assets",
    "build:user": "nest build user-app && pnpm copy:assets",
    "build:admin": "nest build admin-app && pnpm copy:assets",
    "copy:assets": "mkdir -p dist/libs/common/src/templates && cp -r libs/common/src/templates/* dist/libs/common/src/templates/",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "barrels": "barrelsby --config .barrelsby.controller.json && barrelsby --config .barrelsby.module.json",
    "start:admin": "nest start admin-app",
    "start:user": "nest start user-app",
    "debug:admin": "nest start admin-app --debug --watch",
    "debug:user": "nest start user-app --debug --watch",
    "prod:admin": "node dist/apps/admin-app/src/main",
    "prod:user": "node dist/apps/user-app/src/main",
    "migration:generate": "pnpm build:all && ./node_modules/.bin/typeorm migration:generate ./libs/database/src/migration/migration --outputJs --dataSource ./ormconfig.js",
    "migration:run": "pnpm build:all && ./node_modules/.bin/typeorm migration:run --dataSource ./ormconfig.js",
    "migration:revert": "./node_modules/.bin/typeorm migration:revert --dataSource ./ormconfig.js",
    "lint": "eslint \"{src,apps,libs}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
    "@aws-sdk/lib-storage": "^3.958.0",
    "@aws-sdk/s3-request-presigner": "^3.958.0",
    "@nestjs/common": "^11.1.11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.11",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/platform-socket.io": "^11.1.11",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/serve-static": "^5.0.4",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.11",
    "@socket.io/admin-ui": "^0.5.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.13.2",
    "barrelsby": "^2.8.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "firebase-admin": "^13.6.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
