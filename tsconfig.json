{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@app/admin": [
        "libs/admin/src"
      ],
      "@app/admin/*": [
        "libs/admin/src/*"
      ],
      "@app/common": [
        "libs/common/src"
      ],
      "@app/common/*": [
        "libs/common/src/*"
      ],
      "@app/database": [
        "libs/database/src"
      ],
      "@app/database/*": [
        "libs/database/src/*"
      ],
      "@app/event": [
        "libs/event/src"
      ],
      "@app/event-category": [
        "libs/event-category/src"
      ],
      "@app/event-category/*": [
        "libs/event-category/src/*"
      ],
      "@app/event/*": [
        "libs/event/src/*"
      ],
      "@app/libs": [
        "libs"
      ],
      "@app/setting": [
        "libs/setting/src"
      ],
      "@app/setting/*": [
        "libs/setting/src/*"
      ],
      "@app/user": [
        "libs/user/src"
      ],
      "@app/user/*": [
        "libs/user/src/*"
      ],
      "@app/vendor": [
        "libs/vendor/src"
      ],
      "@app/vendor/*": [
        "libs/vendor/src/*"
      ]
    }
  }
}