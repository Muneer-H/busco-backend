{
  "version": 2,
  "buildCommand": "npm run build:admin",
  "outputDirectory": "dist",
  "installCommand": "pnpm install",
  "framework": null,
  "functions": {
    "dist/apps/admin-app/src/main.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/dist/apps/admin-app/src/main.js"
    }
  ]
}
