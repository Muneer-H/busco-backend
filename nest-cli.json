{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/user-app",
  "compilerOptions": {
    "deleteOutDir": false,
    "webpack": false,
    "tsConfigPath": "apps/user-app/tsconfig.app.json",
    "plugins": [
      "@nestjs/swagger/plugin"
    ]
  },
  "projects": {
    "admin": {
      "type": "library",
      "root": "libs/admin",
      "entryFile": "index",
      "sourceRoot": "libs/admin/src",
      "compilerOptions": {
        "tsConfigPath": "libs/admin/tsconfig.lib.json"
      }
    },
    "admin-app": {
      "type": "application",
      "root": "apps/admin-app",
      "entryFile": "main",
      "sourceRoot": "apps/admin-app/src",
      "compilerOptions": {
        "tsConfigPath": "apps/admin-app/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    },
    "device": {
      "type": "library",
      "root": "libs/device",
      "entryFile": "index",
      "sourceRoot": "libs/device/src",
      "compilerOptions": {
        "tsConfigPath": "libs/device/tsconfig.lib.json"
      }
    },
    "event": {
      "type": "library",
      "root": "libs/event",
      "entryFile": "index",
      "sourceRoot": "libs/event/src",
      "compilerOptions": {
        "tsConfigPath": "libs/event/tsconfig.lib.json"
      }
    },
    "event-category": {
      "type": "library",
      "root": "libs/event-category",
      "entryFile": "index",
      "sourceRoot": "libs/event-category/src",
      "compilerOptions": {
        "tsConfigPath": "libs/event-category/tsconfig.lib.json"
      }
    },
    "notification": {
      "type": "library",
      "root": "libs/notification",
      "entryFile": "index",
      "sourceRoot": "libs/notification/src",
      "compilerOptions": {
        "tsConfigPath": "libs/notification/tsconfig.lib.json"
      }
    },
    "setting": {
      "type": "library",
      "root": "libs/setting",
      "entryFile": "index",
      "sourceRoot": "libs/setting/src",
      "compilerOptions": {
        "tsConfigPath": "libs/setting/tsconfig.lib.json"
      }
    },
    "user": {
      "type": "library",
      "root": "libs/user",
      "entryFile": "index",
      "sourceRoot": "libs/user/src",
      "compilerOptions": {
        "tsConfigPath": "libs/user/tsconfig.lib.json"
      }
    },
    "user-app": {
      "type": "application",
      "root": "apps/user-app",
      "entryFile": "main",
      "sourceRoot": "apps/user-app/src",
      "compilerOptions": {
        "tsConfigPath": "apps/user-app/tsconfig.app.json"
      }
    },
    "vendor": {
      "type": "library",
      "root": "libs/vendor",
      "entryFile": "index",
      "sourceRoot": "libs/vendor/src",
      "compilerOptions": {
        "tsConfigPath": "libs/vendor/tsconfig.lib.json"
      }
    }
  }
}